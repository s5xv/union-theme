{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "custom/union-logo",
        "custom/separator-1",
        "custom/union-id",
        "custom/separator-1",
        "hyprland/window"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "custom/union-status",
        "custom/separator-2",
        "cpu",
        "custom/separator-2",
        "memory",
        "custom/separator-2",
        "temperature",
        "custom/separator-2",
        "disk",
        "custom/separator-2",
        "network",
        "custom/separator-2",
        "pulseaudio",
        "custom/separator-2",
        "battery",
        "custom/separator-2",
        "clock",
        "custom/separator-2",
        "tray"
    ],

    "custom/union-logo": {
        "format": "â—‰âŠ•â—‰",
        "tooltip": true,
        "tooltip-format": "UNIFIED NATIONAL INSTITUTE\nFOR ORBITAL AND NUCLEAR RESEARCH\n\nÐ“Ð˜Ð¡Ð¡ â€” FACILITY 04\nEST. 1963\nCLEARANCE: RESTRICTED\n\nPROJECT-014 â”‚ PROJECT-027 â”‚ PROJECT-041\nPROJECT-073 â”‚ PROJECT-â–ˆâ–ˆâ–ˆ",
        "on-click": "rofi -show drun -show-icons"
    },

    "custom/union-id": {
        "format": "UNION // Ð“Ð˜Ð¡Ð¡",
        "tooltip": true,
        "tooltip-format": "FACILITY 04 â€” TERMINAL 7B-114\nDIRECTORATE: ORBITAL RESEARCH\nSTATUS: OPERATIONAL\n\nSerial: UN-04-7B-114\nDate: 1986-11-04"
    },

    "custom/union-status": {
        "format": "SYS",
        "tooltip": true,
        "tooltip-format": "SYSTEM STATUS: NOMINAL\nClick to open btop\nCPU: {cpu}%\nRAM: {memory}%",
        "on-click": "kitty btop"
    },

    "custom/separator-1": {
        "format": "â”‚",
        "tooltip": false
    },

    "custom/separator-2": {
        "format": "Â·",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "â—‹",
            "2": "â—‹",
            "3": "â—",
            "4": "â—‹",
            "5": "â—‹",
            "6": "â—‹"
        },
        "active_workspace": {
            "format": "â—",
            "default": "â—"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        },
        "all-outputs": false,
        "sort-by-number": true,
        "on-click": "activate",
        "tooltip-format": "{id}: {name}\n\n1: ARCHIVE\n2: RESEARCH\n3: ORBITAL\n4: LUNAR\n5: DEEP SPACE\n6: CONTROL",
        "tooltip": true
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "tooltip": false
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": true,
        "tooltip-format": "CPU: {usage}%\nFrequency: {avg_frequency} GHz\nCore count: {num_cores}\nClick to open btop",
        "interval": 2,
        "on-click": "kitty btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "format": "MEM {percentage}%",
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G\nPercentage: {percentage}%\nClick to open btop",
        "interval": 3,
        "on-click": "kitty btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "temperature": {
        "format": "TEMP {temperatureC}Â°",
        "tooltip": true,
        "tooltip-format": "Temperature: {temperatureC}Â°C / {temperatureF}Â°F\nCritical: {temperature_crt}Â°C\nClick to open btop",
        "interval": 5,
        "on-click": "kitty btop",
        "critical-threshold": 80,
        "format-critical": "TEMP {temperatureC}Â°"
    },

    "disk": {
        "format": "DISK {percentage_used}%",
        "tooltip": true,
        "tooltip-format": "Disk: {used} / {total}\nPercentage: {percentage_used}%\nPath: /\nClick to open file manager",
        "path": "/",
        "interval": 30,
        "on-click": "thunar",
        "states": {
            "warning": 80,
            "critical": 95
        }
    },

    "network": {
        "format-wifi": "NET â†‘{bandwidthUpBytes} â†“{bandwidthDownBytes}",
        "format-ethernet": "NET â†‘{bandwidthUpBytes} â†“{bandwidthDownBytes}",
        "format-disconnected": "NET OFFLINE",
        "tooltip": true,
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}\nFrequency: {frequency}MHz",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nSpeed: {bandwidthUpBytes}/s",
        "tooltip-format-disconnected": "Status: DISCONNECTED\nNo active connection",
        "interval": 5
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUTE",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%\nDevice: {desc}\nSource: {source_desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% â†‘",
        "format-plugged": "BAT {capacity}% âš¡",
        "format-full": "BAT FULL",
        "format-icons": ["", "", "", "", "", "", "", "", "", ""],
        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%\nTime: {time_to}\nHealth: {health}\nStatus: {time}",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 30
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
        "interval": 1
    },

    "tray": {
        "icon-size": 14,
        "spacing": 4
    }
}
