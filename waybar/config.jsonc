{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "custom/union-logo",
        "custom/separator-1",
        "custom/union-id"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "cpu",
        "custom/separator-2",
        "memory",
        "custom/separator-2",
        "temperature",
        "custom/separator-2",
        "network",
        "custom/separator-2",
        "pulseaudio",
        "custom/separator-2",
        "battery",
        "custom/separator-2",
        "clock"
    ],

    "custom/union-logo": {
        "format": "◉⊕◉",
        "tooltip": true,
        "tooltip-format": "UNIFIED NATIONAL INSTITUTE\nFOR ORBITAL AND NUCLEAR RESEARCH\n\nГИСС — FACILITY 04\nEST. 1963\nCLEARANCE: RESTRICTED",
        "on-click": "rofi -show drun -show-icons"
    },

    "custom/union-id": {
        "format": "UNION // ГИСС",
        "tooltip": true,
        "tooltip-format": "FACILITY 04 — TERMINAL 7B-114\nDIRECTORATE: ORBITAL RESEARCH\nSTATUS: OPERATIONAL"
    },

    "custom/separator-1": {
        "format": "│",
        "tooltip": false
    },

    "custom/separator-2": {
        "format": "·",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "○",
            "2": "○",
            "3": "●",
            "4": "○",
            "5": "○",
            "6": "○"
        },
        "active_workspace": {
            "format": "●",
            "default": "●"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        },
        "all-outputs": false,
        "sort-by-number": true,
        "on-click": "activate",
        "tooltip-format": "{id}: {name}",
        "tooltip": true
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": true,
        "tooltip-format": "CPU: {usage}%\nFrequency: {avg_frequency} GHz",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "format": "MEM {percentage}%",
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "interval": 3,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "temperature": {
        "format": "TEMP {temperatureC}°",
        "tooltip": true,
        "tooltip-format": "Temperature: {temperatureC}°C / {temperatureF}°F\nCritical: {temperature_crt}°C",
        "interval": 5,
        "critical-threshold": 80,
        "format-critical": "TEMP {temperatureC}°"
    },

    "network": {
        "format-wifi": "NET ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
        "format-ethernet": "NET ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
        "format-disconnected": "NET OFFLINE",
        "tooltip": true,
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nSpeed: {bandwidthUpBytes}/s",
        "interval": 5
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUTE",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%\nDevice: {desc}\nSource: {source_desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% ↑",
        "format-plugged": "BAT {capacity}% ⚡",
        "format-full": "BAT FULL",
        "format-icons": ["", "", "", "", "", "", "", "", "", ""],
        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%\nTime {time_to}\nHealth: {health}",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 30
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip": true,
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 1
    }
}
