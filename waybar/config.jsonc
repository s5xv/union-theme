{
    "layer": "top",
    "position": "bottom",
    "height": 44,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "exclusive": true,
    "passthrough": false,
    "fixed-center": true,

    "modules-left": [
        "custom/union-logo-dock"
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "tray"
    ],

    "custom/union-logo-dock": {
        "format": "âŠ•",
        "tooltip": true,
        "tooltip-format": "UNION // FACILITY 04\nClick: App launcher\nRight-click: Power menu",
        "on-click": "rofi -show drun -show-icons",
        "on-click-right": "/usr/local/bin/union-power"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{app_id}: {title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "_waybar"
        ],
        "app_ids-mapping": {
            "firefox": "firefox",
            "kitty": "terminal"
        },
        "rewrite": {
            "(.*) â€” (.*)": "$1"
        }
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6,
        "tooltip": true
    }
}
