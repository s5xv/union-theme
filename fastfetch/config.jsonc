{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " ── "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "custom",
            "format": "┌─────────────────────────────────────────────┐\n│  {#custom UNION//ГИСС FACILITY 04}         │\n│  Unified National Institute for             │\n│  Orbital and Nuclear Research               │\n└─────────────────────────────────────────────┘"
        },
        "separator",
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "KERNEL"
        },
        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "packages",
            "key": "PACKAGES"
        },
        {
            "type": "shell",
            "key": "SHELL"
        },
        {
            "type": "terminal",
            "key": "TERMINAL"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "separator",
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "MEMORY"
        },
        {
            "type": "disk",
            "key": "DISK"
        },
        "separator",
        {
            "type": "custom",
            "format": "┌─────────────────────────────────────────────┐\n│  FACILITY: 04                               │\n│  DIRECTORATE: ORBITAL RESEARCH              │\n│  CLEARANCE: RESTRICTED                      │\n│  STATUS: OPERATIONAL                        │\n└─────────────────────────────────────────────┘"
        }
    ]
}
