{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " ── "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "de",
        "wm",
        "separator",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "separator",
        {
            "type": "custom",
            "format": "┌─────────────────────────────────────────────┐\n│  FACILITY: 04                               │\n│  DIRECTORATE: ORBITAL RESEARCH              │\n│  CLEARANCE: RESTRICTED                      │\n│  STATUS: OPERATIONAL                        │\n│                                             │\n│  NOTE: Fictional metadata above.            │\n│  This is a theme, not a real organization.  │\n└─────────────────────────────────────────────┘"
        }
    ]
}
