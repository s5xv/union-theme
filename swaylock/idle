# Timeout actions (in seconds)
timeout 300 'swaylock -f -c 1a1d23'
timeout 600 'swaymsg "output * power off"'
timeout 900 'swaymsg "output * power on"'

# Idle behavior
before-sleep 'swaylock -f -c 1a1d23'
after-resume 'swaymsg "output * power on"'

# Lock on lid close (laptops)
lock 'swaylock -f -c 1a1d23'
