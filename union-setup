# â”€â”€â”€ MENU â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
main_menu() {
    while true; do
        echo ""
        echo -e "${C_BOLD}  SELECT STEP:${C_RESET}"
        echo -e "  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€"
        echo -e "  ${C_CYAN}1)${C_RESET} System check"
        echo -e "  ${C_CYAN}2)${C_RESET} Install packages"
        echo -e "  ${C_CYAN}3)${C_RESET} Install theme"
        echo -e "  ${C_CYAN}4)${C_RESET} Setup shell"
        echo -e "  ${C_CYAN}5)${C_RESET} SDDM theme (optional)"
        echo -e "  ${C_CYAN}6)${C_RESET} GRUB theme (optional)"
        echo -e "  ${C_CYAN}7)${C_RESET} Generate sounds"
        echo -e "  ${C_CYAN}8)${C_RESET} Show final info"
        echo -e "  ${C_CYAN}9)${C_RESET} Run ALL steps"
        echo -e "  ${C_CYAN}0)${C_RESET} Exit"
        echo ""
        read -p "  Choice [0-9]: " choice
        echo ""

        case "$choice" in
            1) step_check_system ;;
            2) step_install_packages ;;
            3) step_install_theme ;;
            4) step_setup_shell ;;
            5) step_sddm ;;
            6) step_grub ;;
            7) step_sounds ;;
            8) step_final ;;
            9)
                step_check_system
                step_install_packages
                step_install_theme
                step_setup_shell
                step_sddm
                step_grub
                step_sounds
                step_final
                break
                ;;
            0|q|Q) exit 0 ;;
            *) log_err "Invalid choice" ;;
        esac
    done
}

