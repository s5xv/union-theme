    chmod +x "$SCRIPT_DIR/install.sh"
    "$SCRIPT_DIR/install.sh"

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 4: SETUP SHELL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_setup_shell() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 4: SHELL SETUP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    SHELL_RC=""
    if [[ -f "$HOME/.bashrc" ]]; then
        SHELL_RC="$HOME/.bashrc"
        log_info "Detected bash"
    elif [[ -f "$HOME/.zshrc" ]]; then
        SHELL_RC="$HOME/.zshrc"
        log_info "Detected zsh"
    fi

    if [[ -n "$SHELL_RC" ]]; then
        if ! grep -q "union" "$SHELL_RC" 2>/dev/null; then
            echo ""
            echo "# UNION Theme â€” Shell Integration" >> "$SHELL_RC"
            echo "source ~/.config/shell/aliases.sh 2>/dev/null" >> "$SHELL_RC"
            log_ok "Added UNION to $SHELL_RC"
        else
            log_ok "UNION already in $SHELL_RC"
        fi
    fi

    # Create wallpaper directory
    mkdir -p "$HOME/Pictures/union"
    log_ok "Wallpaper directory created: ~/Pictures/union/"

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 5: SDDM (OPTIONAL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_sddm() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 5: SDDM LOGIN THEME (OPTIONAL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    read -p "  Install SDDM UNION theme? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        if [[ -d /usr/share/sddm ]]; then
            sudo cp -r "$SCRIPT_DIR/sddm/union" /usr/share/sddm/themes/
            mkdir -p /etc/sddm.conf.d
            echo -e "[Theme]\nCurrent=union" | sudo tee /etc/sddm.conf.d/union.conf > /dev/null
            log_ok "SDDM theme installed"
        else
            log_warn "SDDM not found (skipped)"
        fi
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 6: GRUB (OPTIONAL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_grub() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 6: GRUB BOOTLOADER THEME (OPTIONAL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    read -p "  Install GRUB UNION theme? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        if [[ -d /boot/grub ]]; then
            sudo cp -r "$SCRIPT_DIR/grub/" /boot/grub/themes/union/
            if ! grep -q "UNION" /etc/default/grub 2>/dev/null; then
                echo 'GRUB_THEME="/boot/grub/themes/union/theme.txt"' | sudo tee -a /etc/default/grub > /dev/null
                sudo grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || log_warn "Run grub-mkconfig manually"
            fi
            log_ok "GRUB theme installed"
        else
            log_warn "/boot/grub not found (skipped)"
        fi
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 7: SOUNDS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
