    echo ""
    echo -e "  ${C_BOLD}Quick Reference:${C_RESET}"
    echo -e "  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€"
    echo -e "  SUPER+Return      Terminal"
    echo -e "  SUPER+D           App launcher"
    echo -e "  SUPER+W           Firefox"
    echo -e "  SUPER+S           btop"
    echo -e "  SUPER+SHIFT+P     Power menu"
