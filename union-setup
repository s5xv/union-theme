    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 7: SOUND EFFECTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    if command -v sox &>/dev/null; then
        /usr/local/bin/union-sounds 2>/dev/null || true
        log_ok "Sound effects generated"
    else
        log_warn "Sox not installed (no sound effects)"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 8: FINAL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
