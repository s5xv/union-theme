log_info()  { echo -e "  ${C_BLUE}[INFO]${C_RESET}  $1"; }
log_ok()    { echo -e "  ${C_GREEN}[OK]${C_RESET}    $1"; }
log_warn()  { echo -e "  ${C_AMBER}[WARN]${C_RESET}  $1"; }
log_err()   { echo -e "  ${C_RED}[ERR]${C_RESET}   $1"; }

# â”€â”€â”€ STEP 1: SYSTEM CHECK â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_check_system() {
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 1: SYSTEM CHECK â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    local issues=0

    if [[ -f /etc/arch-release ]]; then
        log_ok "Arch Linux detected"
    else
        log_warn "Not Arch Linux â€” some install commands may differ"
        ((issues++))
    fi

    for cmd in Hyprland waybar kitty rofi mako swww starship jq sox nvim tmux btop; do
        if command -v "$cmd" &>/dev/null || [[ -f "/usr/bin/$cmd" ]]; then
            log_ok "$cmd found"
        else
            log_warn "$cmd not found (will try to install)"
            ((issues++))
        fi
    done

    echo ""
    if [[ $issues -gt 0 ]]; then
        log_info "$issues items need attention (install step will try to fix)"
    else
        log_ok "System looks good"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 2: INSTALL PACKAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_install_packages() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 2: INSTALL PACKAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    if ! command -v pacman &>/dev/null; then
        log_warn "pacman not found â€” install packages manually:"
        echo "    hyprland waybar kitty rofi-wayland mako swww starship jq"
        echo "    grimblast-git brightnessctl wireplumber polkit-gnome"
        echo "    sox playerctl thunar btop neovim tmux"
        echo "    swaylock swayidle grim slurp wl-clipboard"
        echo "    nm-applet blueman fzf fd"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    read -p "  Install packages via pacman? [Y/n] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Nn]$ ]]; then
        log_info "Skipping package installation"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    log_info "Updating package database..."
    sudo pacman -Sy --noconfirm 2>/dev/null || true

    # Required packages
    PACKAGES=(
        hyprland waybar kitty rofi-wayland mako swww starship jq
        grimblast-git brightnessctl wireplumber
        xdg-desktop-portal-hyprland polkit-gnome
        sox playerctl thunar btop neovim tmux
        swaylock swayidle grim slurp wl-clipboard
        nm-applet blueman fzf fd
    )

    # Optional packages
    OPTIONAL_PACKAGES=(
        fastfetch neofetch papirus-icon-theme
        ttf-jetbrains-mono-nerd cliphist
        lazygit lazydocker ranger dunst wofi libnotify
    )

    for pkg in "${PACKAGES[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null 2>&1; then
            log_info "Installing $pkg..."
            sudo pacman -S --noconfirm "$pkg" 2>/dev/null || log_warn "Failed to install $pkg (may not exist in repos)"
        else
            log_ok "$pkg already installed"
        fi
    done

    echo ""
    log_info "Optional packages (install if you want extra features):"
    for pkg in "${OPTIONAL_PACKAGES[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null 2>&1; then
            echo "    - $pkg"
        fi
    done
    echo ""
    read -p "  Install optional packages too? [y/N] " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        for pkg in "${OPTIONAL_PACKAGES[@]}"; do
            if ! pacman -Qi "$pkg" &>/dev/null 2>&1; then
                log_info "Installing $pkg..."
                sudo pacman -S --noconfirm "$pkg" 2>/dev/null || log_warn "Failed to install $pkg"
            fi
        done
    fi

    log_ok "Package installation complete"
    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 3: INSTALL THEME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_install_theme() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 3: INSTALL THEME FILES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    if [[ ! -f "$SCRIPT_DIR/install.sh" ]]; then
        log_err "install.sh not found in $SCRIPT_DIR"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    chmod +x "$SCRIPT_DIR/install.sh"
    bash "$SCRIPT_DIR/install.sh" --install

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 4: SDDM LOGIN THEME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_sddm() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 4: SDDM LOGIN THEME (OPTIONAL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    if [[ ! -d /usr/share/sddm ]]; then
        log_info "SDDM not installed on this system (skipped)"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    if [[ ! -d "$SCRIPT_DIR/sddm/union" ]]; then
        log_err "SDDM theme files not found"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    read -p "  Install SDDM UNION login theme? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        sudo cp -r "$SCRIPT_DIR/sddm/union" /usr/share/sddm/themes/
        mkdir -p /etc/sddm.conf.d
        echo -e "[Theme]\nCurrent=union" | sudo tee /etc/sddm.conf.d/union.conf > /dev/null
        log_ok "SDDM UNION theme installed"
        log_info "Restart SDDM or reboot to see it"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 5: GRUB BOOTLOADER THEME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_grub() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 5: GRUB BOOTLOADER THEME (OPTIONAL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    if [[ ! -d /boot/grub ]]; then
        log_info "GRUB not found on this system (skipped)"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    if [[ ! -f "$SCRIPT_DIR/grub/theme.txt" ]]; then
        log_err "GRUB theme files not found"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    read -p "  Install GRUB UNION bootloader theme? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        sudo mkdir -p /boot/grub/themes/union
        sudo cp -r "$SCRIPT_DIR/grub/"* /boot/grub/themes/union/

        if ! grep -q "UNION" /etc/default/grub 2>/dev/null; then
            echo 'GRUB_THEME="/boot/grub/themes/union/theme.txt"' | sudo tee -a /etc/default/grub > /dev/null
        fi

        if command -v grub-mkconfig &>/dev/null; then
            sudo grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || log_warn "grub-mkconfig failed â€” run manually"
        else
            log_warn "grub-mkconfig not found â€” run manually after install"
        fi

        log_ok "GRUB UNION theme installed"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 6: SOUND EFFECTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_sounds() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 6: SOUND EFFECTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    if ! command -v sox &>/dev/null; then
        log_warn "Sox not installed â€” no sound effects"
        echo "    Install with: sudo pacman -S sox"
        echo ""
        read -p "  Press Enter to continue..."
        return
    fi

    if [[ -x /usr/local/bin/union-sounds ]]; then
        /usr/local/bin/union-sounds startup 2>/dev/null || true
        log_ok "Sound effects generated and tested"
    else
        log_warn "union-sounds not installed yet (run install step first)"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 7: FINAL SUMMARY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_final() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ SETUP COMPLETE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""
    echo -e "  ${C_GREEN}${C_BOLD}UNION THEME INSTALLED SUCCESSFULLY${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}Restart Hyprland or log out and back in to see changes.${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}Keybindings:${C_RESET}"
    echo -e "  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€"
    echo -e "  SUPER+Return        Terminal"
    echo -e "  SUPER+D             App launcher"
    echo -e "  SUPER+W             Firefox"
    echo -e "  SUPER+S             btop"
    echo -e "  SUPER+SHIFT+P       Power menu"
    echo -e "  SUPER+SHIFT+W       Wallpaper picker"
    echo -e "  SUPER+L             Lock screen"
    echo -e "  SUPER+Space         Toggle Arabic/English"
    echo -e "  SUPER+1-6           Switch workspace"
    echo -e "  SUPER+C             Clipboard history"
    echo ""
    echo -e "  ${C_BOLD}Terminal Banner:${C_RESET}"
    echo -e "  Edit ~/.bashrc or ~/.zshrc and uncomment 'union-login'"
    echo ""
    echo -e "  ${C_BOLD}Switch to Dock:${C_RESET}"
    echo -e "  pkill waybar && waybar -c ~/.config/waybar/dock.jsonc -s ~/.config/waybar/dock-style.css &"
    echo ""
    echo -e "  ${C_DIM}FACILITY 04 â€” STATUS: OPERATIONAL${C_RESET}"
    echo ""
}

# â”€â”€â”€ MAIN MENU â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
main_menu() {
    while true; do
        echo ""
        echo -e "${C_BOLD}  SELECT STEP:${C_RESET}"
        echo -e "  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€"
        echo -e "  ${C_BLUE}1)${C_RESET}  System check"
        echo -e "  ${C_BLUE}2)${C_RESET}  Install packages"
        echo -e "  ${C_BLUE}3)${C_RESET}  Install theme files"
        echo -e "  ${C_BLUE}4)${C_RESET}  SDDM login theme (optional)"
        echo -e "  ${C_BLUE}5)${C_RESET}  GRUB bootloader theme (optional)"
        echo -e "  ${C_BLUE}6)${C_RESET}  Generate sound effects"
        echo -e "  ${C_BLUE}7)${C_RESET}  Show summary"
        echo -e "  ${C_BLUE}9)${C_RESET}  ${C_BOLD}Run ALL steps automatically${C_RESET}"
        echo -e "  ${C_BLUE}0)${C_RESET}  Exit"
        echo ""
        read -p "  Choice [0-9]: " choice
        echo ""

        case "$choice" in
            1) step_check_system ;;
            2) step_install_packages ;;
            3) step_install_theme ;;
            4) step_sddm ;;
            5) step_grub ;;
            6) step_sounds ;;
            7) step_final ;;
            9)
                echo -e "  ${C_BOLD}Running all steps...${C_RESET}"
                echo ""
                step_check_system
                step_install_packages
                step_install_theme
                step_sddm
                step_grub
                step_sounds
                step_final
                break
                ;;
            0|q|Q)
                echo ""
                echo -e "  ${C_DIM}FACILITY 04 â€” Goodbye.${C_RESET}"
                echo ""
                exit 0
                ;;
            *)
                log_err "Invalid choice"
                ;;
        esac
    done
}

# â”€â”€â”€ MAIN â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
main() {
    print_header
    main_menu
}

main "$@"
