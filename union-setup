# â”€â”€â”€ STEP 1: CHECK SYSTEM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_check_system() {
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 1: SYSTEM CHECK â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    # Check Arch
    if [[ -f /etc/arch-release ]]; then
        log_ok "Arch Linux detected"
    else
        log_warn "Not running Arch Linux (some features may differ)"
    fi

    # Check Hyprland
    if command -v Hyprland &>/dev/null; then
        log_ok "Hyprland installed"
    else
        log_err "Hyprland not found"
    fi

    # Check waybar
    if command -v waybar &>/dev/null; then
        log_ok "Waybar installed"
    else
        log_warn "Waybar not found (will be installed)"
    fi

    # Check kitty
    if command -v kitty &>/dev/null; then
        log_ok "Kitty installed"
    else
        log_warn "Kitty not found (will be installed)"
    fi

    # Check starship
    if command -v starship &>/dev/null; then
        log_ok "Starship installed"
    else
        log_warn "Starship not found (will be installed)"
    fi

    # Check sox
    if command -v sox &>/dev/null; then
        log_ok "Sox installed (sound effects enabled)"
    else
        log_warn "Sox not found (sound effects disabled)"
    fi

    # Check neovim
    if command -v nvim &>/dev/null; then
        log_ok "Neovim installed"
    else
        log_warn "Neovim not found (will be installed)"
    fi

    # Check tmux
    if command -v tmux &>/dev/null; then
        log_ok "Tmux installed"
    else
        log_warn "Tmux not found (will be installed)"
    fi

    # Check btop
    if command -v btop &>/dev/null; then
        log_ok "btop installed"
    else
        log_warn "btop not found (will be installed)"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 2: INSTALL PACKAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_install_packages() {
    echo ""
    echo -e "${C_BOLD}  â”€â”€â”€ STEP 2: INSTALL PACKAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""

    read -p "  Install missing packages via pacman? [Y/n] " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Nn]$ ]]; then
        log_info "Updating package database..."
        sudo pacman -Sy --noconfirm 2>/dev/null || true

        PACKAGES=(
            hyprland waybar kitty rofi-wayland mako swww starship jq
            grimblast-git brightnessctl wireplumber
            xdg-desktop-portal-hyprland polkit-gnome
            sox playerctl thunar btop neovim tmux
            swaylock swayidle grim slurp wl-clipboard
            nm-applet blueman fzf fd
        )

        for pkg in "${PACKAGES[@]}"; do
            if ! pacman -Qi "$pkg" &>/dev/null; then
                log_info "Installing $pkg..."
                sudo pacman -S --noconfirm "$pkg" 2>/dev/null || log_warn "Failed to install $pkg"
            fi
        done

        log_ok "Package installation complete"
    fi

    echo ""
    read -p "  Press Enter to continue..."
}

# â”€â”€â”€ STEP 3: INSTALL THEME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
step_install_theme() {
