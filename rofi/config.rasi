@import "union.rasi"

configuration {
    modi: "drun,run,window,filebrowser,calc,ssh";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";
    font: "JetBrains Mono 11";
    display-drun: "RESEARCH";
    display-run: "EXECUTE";
    display-window: "WINDOWS";
    display-filebrowser: "ARCHIVE";
    display-calc: "CALCULATOR";
    display-ssh: "REMOTE";
    drun-display-format: "{name}";
    click-to-exit: true;
    sidebar-mode: false;
    scroll-method: 0;
    hide-hotkeys: false;
    title: "UNION // APPLICATION DIRECTORY";
}
