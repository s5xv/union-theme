# â”€â”€â”€ SYSTEM STATUS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
print_status() {
    local hostname=$(hostname)
    local kernel=$(uname -r)
    local uptime=$(uptime -p 2>/dev/null || uptime | sed 's/.*up /up /' | sed 's/,.*//')
    local date=$(date '+%Y-%m-%d')
    local time=$(date '+%H:%M:%S')
    local terminal=$(tty | sed 's|/dev/||')
    local user=$(whoami)

    echo -e "  ${C_FACILITY:=$C_FG}FACILITY:${C_RESET}        04"
    echo -e "  ${C_FG}TERMINAL:${C_RESET}        ${terminal:-7B-114}"
    echo -e "  ${C_FG}ACCESS LEVEL:${C_RESET}    â–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆ"
    echo -e "  ${C_FG}OPERATOR:${C_RESET}        ${user}"
    echo ""
    echo -e "  ${C_DIM}â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""
    echo -e "  ${C_GREEN}SYSTEM STATUS${C_RESET} ............ NOMINAL"
    echo -e "  ${C_GREEN}ARCHIVE${C_RESET} .................. ONLINE"
    echo -e "  ${C_GREEN}COMMUNICATIONS${C_RESET} ........... ONLINE"
    echo -e "  ${C_GREEN}RESEARCH NETWORK${C_RESET} ......... ONLINE"
    echo -e "  ${C_AMBER}ORBITAL RELAY${C_RESET} ............ STANDBY"
    echo -e "  ${C_GREEN}NUCLEAR MONITOR${C_RESET} .......... ACTIVE"
    echo ""
    echo -e "  ${C_DIM}â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
    echo ""
    echo -e "  ${C_DIM}${date} ${time}  â”‚  ${hostname}  â”‚  kernel ${kernel}${C_RESET}"
    echo ""
}

# â”€â”€â”€ ANIMATED LOADING â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
animate_status() {
    if [[ "$UNION_LOGIN_ANIMATE" == "1" ]]; then
        local items=(
            "SYSTEM STATUS"
            "ARCHIVE"
            "COMMUNICATIONS"
            "RESEARCH NETWORK"
            "ORBITAL RELAY"
            "NUCLEAR MONITOR"
        )
        local statuses=("ONLINE" "ONLINE" "ONLINE" "STANDBY" "ACTIVE")

        echo ""
        for item in "${items[@]}"; do
            echo -ne "\r  ${C_FG}${item}${C_RESET} ..."
            sleep 0.1
            echo -ne "\r  ${C_GREEN}${item}${C_RESET} ............ DONE "
            sleep 0.05
            echo ""
        done
        echo ""
    fi
}

# â”€â”€â”€ MAIN â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
main() {
    if [[ "$UNION_LOGIN_BANNER" == "0" ]]; then
        return 0
    fi

    clear
    print_logo
    print_banner
    animate_status
    print_status
}

main "$@"
