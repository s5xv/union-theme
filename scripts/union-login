# â”€â”€â”€ BANNER TEXT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
print_banner() {
    echo -e "${C_FG}${C_BOLD}"
    echo "  UNION SCIENTIFIC COMPUTING SYSTEM"
    echo -e "${C_DIM}  â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•${C_RESET}"
    echo ""
    echo -e "${C_FG}  Ð“ÐžÐ¡Ð£Ð”ÐÐ Ð¡Ð¢Ð’Ð•ÐÐÐ«Ð™ Ð˜ÐÐ¡Ð¢Ð˜Ð¢Ð£Ð¢"
    echo "  Ð¡ÐŸÐ•Ð¦Ð˜ÐÐ›Ð¬ÐÐ«Ð¥ Ð˜Ð¡Ð¡Ð›Ð•Ð”ÐžÐ’ÐÐÐ˜Ð™"
    echo ""
    echo -e "${C_DIM}  UNIFIED NATIONAL INSTITUTE"
    echo "  FOR ORBITAL AND NUCLEAR RESEARCH${C_RESET}"
    echo ""
    echo -e "${C_DIM}  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€${C_RESET}"
