# Facility 04 â€” Terminal 7B-114
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€â”€ CONFIGURATION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set to 0 to disable startup banner
UNION_LOGIN_BANNER="${UNION_LOGIN_BANNER:-1}"

# Set to 0 to disable animations
UNION_LOGIN_ANIMATE="${UNION_LOGIN_ANIMATE:-1}"

# Colors
C_RED='\033[0;31m'
C_BLUE='\033[0;34m'
C_GREEN='\033[0;32m'
C_AMBER='\033[0;33m'
C_CYAN='\033[0;36m'
C_VIOLET='\033[0;35m'
C_DIM='\033[2m'
C_BOLD='\033[1m'
C_RESET='\033[0m'
C_BG='\033[48;5;234m'
C_FG='\033[38;5;252m'

# â”€â”€â”€ ASCII LOGO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
print_logo() {
    echo ""
    echo -e "${C_RED}${C_BOLD}"
    echo "         â•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—"
    echo "         â•‘                                   â•‘"
    echo "         â•‘        â—‰ â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ â—‰           â•‘"
    echo "         â•‘        â”‚ â•²     â˜…   â•± â”‚           â•‘"
    echo "         â•‘        â”‚   â•²  â”‚  â•±   â”‚           â•‘"
    echo "         â•‘   â—‰ â”€â”€â”€â”‚â”€â”€â”€â”€â”€âŠ•â”€â”€â”€â”€â”€â”€â”‚â”€â”€â”€ â—‰       â•‘"
    echo "         â•‘        â”‚   â•±  â”‚  â•²   â”‚           â•‘"
    echo "         â•‘        â”‚ â•±         â•² â”‚           â•‘"
    echo "         â•‘        â—‰ â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ â—‰           â•‘"
    echo "         â•‘                                   â•‘"
    echo "         â• â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•£"
    echo "         â•‘     UNION // Ð“Ð˜Ð¡Ð¡ // FACILITY 04  â•‘"
    echo "         â•‘     EST. 1963                     â•‘"
    echo "         â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•"
    echo -e "${C_RESET}"
