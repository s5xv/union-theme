# UNION â€” ASCII LOGO DISPLAY
# Unified National Institute for Orbital and Nuclear Research
# Ð“Ð¾ÑÑƒÐ´Ð°Ñ€ÑÑ‚Ð²ÐµÐ½Ð½Ñ‹Ð¹ Ð¸Ð½ÑÑ‚Ð¸Ñ‚ÑƒÑ‚ ÑÐ¿ÐµÑ†Ð¸Ð°Ð»ÑŒÐ½Ñ‹Ñ… Ð¸ÑÑÐ»ÐµÐ´Ð¾Ð²Ð°Ð½Ð¸Ð¹
# Facility 04 â€” Terminal 7B-114
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNION_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
C_RED='\033[0;31m'
C_DIM='\033[2m'
C_BOLD='\033[1m'
C_RESET='\033[0m'
C_FG='\033[38;5;252m'

print_large() {
    cat "${UNION_DIR}/ascii/union-large.txt"
}

print_medium() {
    cat "${UNION_DIR}/ascii/union-medium.txt"
}

print_small() {
    cat "${UNION_DIR}/ascii/union-small.txt"
}

print_boot() {
    cat "${UNION_DIR}/ascii/union-boot.txt"
}

print_status() {
    cat "${UNION_DIR}/ascii/union-status.txt"
}

print_classified() {
    cat "${UNION_DIR}/ascii/union-classified.txt"
}

print_facility() {
    cat "${UNION_DIR}/ascii/union-facility.txt"
}

print_fallback() {
    echo ""
    echo "     â•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—"
    echo "     â•‘     â—‰ â”€â”€âŠ•â”€â”€ â—‰               â•‘"
    echo "     â•‘     UNION // Ð“Ð˜Ð¡Ð¡             â•‘"
    echo "     â•‘     FACILITY 04               â•‘"
    echo "     â•‘     EST. 1963                 â•‘"
    echo "     â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•"
    echo ""
}

usage() {
    echo "Usage: union-logo [OPTION]"
    echo ""
    echo "Display UNION ASCII art"
    echo ""
    echo "Options:"
    echo "  large       Large detailed terminal version (default)"
    echo "  medium      Medium institutional version"
    echo "  small       Tiny terminal icon"
    echo "  boot        Boot/startup banner"
    echo "  status      System status panel"
    echo "  classified  Classification stamp"
    echo "  facility    Facility identification panel"
    echo "  fallback    Pure ASCII fallback"
    echo "  --help      Show this help"
}

main() {
    local size="${1:-large}"

    case "$size" in
        large)      print_large ;;
        medium)     print_medium ;;
        small)      print_small ;;
        boot)       print_boot ;;
        status)     print_status ;;
        classified) print_classified ;;
        facility)   print_facility ;;
        fallback)   print_fallback ;;
        --help|-h)  usage ;;
        *)          print_large ;;
    esac
}

main "$@"
