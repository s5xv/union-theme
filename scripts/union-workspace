#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
# UNION — WORKSPACE INDICATOR
# Unified National Institute for Orbital and Nuclear Research
# Государственный институт специальных исследований
# Facility 04 — Terminal 7B-114
# ═══════════════════════════════════════════════════════════════════

# Workspace names
declare -A WS_NAMES=(
    [1]="ARCHIVE"
    [2]="RESEARCH"
    [3]="ORBITAL"
    [4]="LUNAR"
    [5]="DEEP SPACE"
    [6]="CONTROL"
)

# Workspace colors (ANSI)
declare -A WS_COLORS=(
    [1]='\033[0;31m'  # Red
    [2]='\033[0;34m'  # Blue
    [3]='\033[0;32m'  # Green
    [4]='\033[0;33m'  # Amber
    [5]='\033[0;35m'  # Violet
    [6]='\033[0;36m'  # Cyan
)

C_DIM='\033[2m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

get_active_workspace() {
    if command -v hyprctl &> /dev/null; then
        hyprctl activeworkspace -j | jq -r '.id'
    else
        echo "1"
    fi
}

get_workspace_windows() {
    local ws="$1"
    if command -v hyprctl &> /dev/null; then
        hyprctl workspaces -j | jq -r ".[] | select(.id == $ws) | .windows"
    else
        echo "0"
    fi
}

print_workspace_dots() {
    local active=$(get_active_workspace)

    echo -n "  "
    for ws in 1 2 3 4 5 6; do
        local name="${WS_NAMES[$ws]}"
        local color="${WS_COLORS[$ws]}"
        local windows=$(get_workspace_windows "$ws")

        if [[ "$ws" == "$active" ]]; then
            echo -ne "${color}${C_BOLD}●${C_RESET}"
        elif [[ "$windows" -gt 0 ]]; then
            echo -ne "${C_DIM}◉${C_RESET}"
        else
            echo -ne "${C_DIM}○${C_RESET}"
        fi

        echo -n " "
    done
    echo ""
}

print_workspace_info() {
    local active=$(get_active_workspace)
    local name="${WS_NAMES[$active]:-UNKNOWN}"
    local color="${WS_COLORS[$active]:-\033[0m}"

    echo -e "${color}${C_BOLD}${name}${C_RESET}"
}

print_full_indicator() {
    echo -e "${C_DIM}═══════════════════════════════════════════════════${C_RESET}"
    print_workspace_dots
    echo -n "  "
    print_workspace_info
    echo -e "${C_DIM}═══════════════════════════════════════════════════${C_RESET}"
}

print_compact() {
    local active=$(get_active_workspace)

    for ws in 1 2 3 4 5 6; do
        if [[ "$ws" == "$active" ]]; then
            echo -n "●"
        else
            echo -n "○"
        fi
    done
    echo ""
}

usage() {
    echo "Usage: union-workspace [OPTION]"
    echo ""
    echo "UNION Workspace Indicator"
    echo ""
    echo "Options:"
    echo "  --full      Full workspace indicator with names"
    echo "  --compact   Compact dot indicator (for waybar)"
    echo "  --active    Show current workspace name"
    echo "  --help      Show this help"
}

main() {
    case "${1:-}" in
        --full)
            print_full_indicator
            ;;
        --compact)
            print_compact
            ;;
        --active)
            print_workspace_info
            ;;
        --help|-h)
            usage
            ;;
        *)
            print_full_indicator
            ;;
    esac
}

main "$@"
