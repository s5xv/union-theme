#!/bin/bash
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# UNION â€” NOTIFICATION SYSTEM
# Unified National Institute for Orbital and Nuclear Research
# Ð“Ð¾ÑÑƒÐ´Ð°Ñ€ÑÑ‚Ð²ÐµÐ½Ð½Ñ‹Ð¹ Ð¸Ð½ÑÑ‚Ð¸Ñ‚ÑƒÑ‚ ÑÐ¿ÐµÑ†Ð¸Ð°Ð»ÑŒÐ½Ñ‹Ñ… Ð¸ÑÑÐ»ÐµÐ´Ð¾Ð²Ð°Ð½Ð¸Ð¹
# Facility 04 â€” Terminal 7B-114
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€â”€ CONFIGURATION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
UNION_NOTIFY_ENABLED="${UNION_NOTIFY_ENABLED:-1}"
UNION_NOTIFY_APP_NAME="UNION // SYSTEM"
UNION_NOTIFY_TIMEOUT=5000
UNION_NOTIFY_SOUND="${UNION_NOTIFY_SOUND:-1}"

# â”€â”€â”€ SOUND EFFECTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
play_sound() {
    if [[ "$UNION_NOTIFY_SOUND" != "1" ]]; then
        return 0
    fi
    if [[ -x "/usr/local/bin/union-sounds" ]]; then
        /usr/local/bin/union-sounds "$1" &
    fi
}

# â”€â”€â”€ MESSAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
send_notification() {
    local app_name="$1"
    local summary="$2"
    local body="$3"
    local urgency="${4:-normal}"
    local icon="${5:-}"
    local sound="${6:-notify}"

    if [[ "$UNION_NOTIFY_ENABLED" != "1" ]]; then
        return 0
    fi

    play_sound "$sound"

    if command -v makoctl &> /dev/null; then
        makoctl invoke --app-name "$app_name" --summary "$summary" --body "$body" --urgency "$urgency" 2>/dev/null
    elif command -v notify-send &> /dev/null; then
        notify-send -u "$urgency" -a "$app_name" "$summary" "$body" 2>/dev/null
    fi
}

# â”€â”€â”€ SYSTEM NOTIFICATIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
notify_system() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // SYSTEM" "$message" "$body" "normal" "" "notify"
}

notify_communications() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // COMMUNICATIONS" "$message" "$body" "normal" "" "notify"
}

notify_audio() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // AUDIO SYSTEM" "$message" "$body" "low" "" "vol-tick"
}

notify_optical() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // OPTICAL SYSTEM" "$message" "$body" "normal" "" "notify"
}

notify_application() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // APPLICATION CONTROL" "$message" "$body" "normal" "" "notify"
}

notify_warning() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // WARNING" "$message" "$body" "critical" "" "warning"
}

notify_transfer() {
    local message="$1"
    local body="${2:-}"
    send_notification "UNION // DATA TRANSFER" "$message" "$body" "low" "" "notify"
}

# â”€â”€â”€ PRESET NOTIFICATIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
preset_startup() {
    notify_system "SYSTEM INITIALIZED" "UNION workstation online.\nFacility: 04\nTerminal: 7B-114\nStatus: NOMINAL"
}

preset_shutdown() {
    notify_system "SYSTEM SHUTDOWN" "UNION workstation powering down.\nFacility: 04\nStatus: SECURED"
}

preset_headphones_connected() {
    notify_communications "WIRELESS LINK ESTABLISHED" "Device: Headphones\nStatus: Connected\nChannel: ACTIVE"
}

preset_headphones_disconnected() {
    notify_communications "WIRELESS LINK TERMINATED" "Device: Headphones\nStatus: Disconnected\nChannel: STANDBY"
}

preset_volume_change() {
    local vol="${1:-0}"
    notify_audio "OUTPUT: ${vol}%"
}

preset_brightness_change() {
    local bright="${1:-0}"
    notify_optical "INTENSITY: ${bright}%"
}

preset_app_launch() {
    local app="${1:-unknown}"
    notify_application "PROCESS INITIALIZED" "Application: ${app}\nStatus: LOADED"
}

preset_app_close() {
    local app="${1:-unknown}"
    notify_application "PROCESS TERMINATED" "Application: ${app}\nStatus: CLOSED"
}

preset_screenshot() {
    notify_transfer "CAPTURE COMPLETE" "Screenshot archived.\nLocation: ~/Pictures/union/\nStatus: SAVED"
}

preset_workspace_change() {
    local ws="${1:-1}"
    local name="${2:-UNKNOWN}"
    notify_system "WORKSPACE ACTIVE" "Sector: ${ws}\nDesignation: ${name}"
}

preset_lock_screen() {
    notify_system "SCREEN LOCKED" "Security protocol activated.\nFacility: 04\nStatus: LOCKED"
}

preset_battery_low() {
    local pct="${1:-0}"
    notify_warning "POWER CRITICAL" "Battery: ${pct}%\nStatus: CRITICAL\nConnect power immediately."
}

preset_battery_warning() {
    local pct="${1:-0}"
    notify_warning "POWER WARNING" "Battery: ${pct}%\nStatus: LOW\nConsider connecting power."
}

preset_network_connected() {
    notify_communications "NETWORK LINK ESTABLISHED" "Connection: ACTIVE\nStatus: ONLINE"
}

preset_network_disconnected() {
    notify_communications "NETWORK LINK TERMINATED" "Connection: LOST\nStatus: OFFLINE"
}

preset_bluetooth_connected() {
    notify_communications "BLUETOOTH LINK ESTABLISHED" "Device: ${1:-unknown}\nStatus: CONNECTED"
}

preset_bluetooth_disconnected() {
    notify_communications "BLUETOOTH LINK TERMINATED" "Device: ${1:-unknown}\nStatus: DISCONNECTED"
}

preset_mirror_open() {
    notify_system "DISPLAY MIRROR ACTIVATED" "External display detected.\nStatus: MIRROR MODE"
}

preset_mirror_off() {
    notify_system "DISPLAY MIRROR DEACTIVATED" "External display disconnected.\nStatus: SINGLE MODE"
}

# â”€â”€â”€ MAIN â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
main() {
    case "${1:-}" in
        --system)
            shift
            notify_system "$@"
            ;;
        --communications)
            shift
            notify_communications "$@"
            ;;
        --audio)
            shift
            notify_audio "$@"
            ;;
        --optical)
            shift
            notify_optical "$@"
            ;;
        --application)
            shift
            notify_application "$@"
            ;;
        --warning)
            shift
            notify_warning "$@"
            ;;
        --transfer)
            shift
            notify_transfer "$@"
            ;;
        --preset-startup)
            preset_startup
            ;;
        --preset-headphones)
            preset_headphones_connected
            ;;
        --preset-headphones-off)
            preset_headphones_disconnected
            ;;
        --preset-volume)
            preset_volume_change "${2:-0}"
            ;;
        --preset-brightness)
            preset_brightness_change "${2:-0}"
            ;;
        --preset-app)
            preset_app_launch "${2:-unknown}"
            ;;
        --preset-app-close)
            preset_app_close "${2:-unknown}"
            ;;
        --preset-screenshot)
            preset_screenshot
            ;;
        --preset-workspace)
            preset_workspace_change "${2:-1}" "${3:-UNKNOWN}"
            ;;
        --preset-lock)
            preset_lock_screen
            ;;
        --preset-battery-low)
            preset_battery_low "${2:-0}"
            ;;
        --preset-battery-warning)
            preset_battery_warning "${2:-0}"
            ;;
        --preset-network)
            preset_network_connected
            ;;
        --preset-network-off)
            preset_network_disconnected
            ;;
        --preset-bluetooth)
            preset_bluetooth_connected "${2:-unknown}"
            ;;
        --preset-bluetooth-off)
            preset_bluetooth_disconnected "${2:-unknown}"
            ;;
        --preset-shutdown)
            preset_shutdown
            ;;
        --help|-h)
            echo "Usage: union-notify [OPTION] [MESSAGE] [BODY]"
            echo ""
            echo "UNION Notification System"
            echo ""
            echo "Options:"
            echo "  --system MSG BODY           System notification"
            echo "  --communications MSG BODY   Communications notification"
            echo "  --audio MSG BODY            Audio system notification"
            echo "  --optical MSG BODY          Optical system notification"
            echo "  --application MSG BODY      Application control notification"
            echo "  --warning MSG BODY          Warning notification"
            echo "  --transfer MSG BODY         Data transfer notification"
            echo ""
            echo "Presets:"
            echo "  --preset-startup            Startup notification"
            echo "  --preset-shutdown           Shutdown notification"
            echo "  --preset-headphones         Headphones connected"
            echo "  --preset-headphones-off     Headphones disconnected"
            echo "  --preset-volume VOL         Volume change"
            echo "  --preset-brightness VAL     Brightness change"
            echo "  --preset-app NAME           App launch"
            echo "  --preset-app-close NAME     App close"
            echo "  --preset-screenshot         Screenshot taken"
            echo "  --preset-workspace NUM NAME Workspace change"
            echo "  --preset-lock               Screen locked"
            echo "  --preset-battery-low PCT    Battery critical"
            echo "  --preset-battery-warning PCT Battery low"
            echo "  --preset-network            Network connected"
            echo "  --preset-network-off        Network disconnected"
            echo "  --preset-bluetooth DEVICE   Bluetooth connected"
            echo "  --preset-bluetooth-off DEVICE Bluetooth disconnected"
            echo ""
            echo "Configuration:"
            echo "  Set UNION_NOTIFY_ENABLED=0 to disable all notifications"
            ;;
        *)
            echo "Use --help for usage information"
            ;;
    esac
}

main "$@"
